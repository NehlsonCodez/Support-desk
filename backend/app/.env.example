# Copy this file to .env and fill in real values.
# The .env file is git-ignored, so secrets never leave your machine.

# Secret used to sign JWT access tokens (use a long random string)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256

# Async PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5438/support_desk

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MIN=60

# Base URL of the API
BACKEND_URL=http://localhost:8000
